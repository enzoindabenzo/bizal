# BizAL — environment template (NO VALUES)
#
# Usage:   cp .env.example .env      (repo root, next to docker-compose.yml)
# Then uncomment ONLY the lines you actually want to set.
#
# Why every line is commented out: python-dotenv turns a bare `KEY=` into an
# empty string, and an empty string counts as "set", so it overrides the
# code's built-in default (e.g. `DB_HOST=` would replace 'localhost' with '').
# A commented-out line is truly unset, so the default applies.
#
# Real environment variables (Docker, Railway, CI) always win over this file.
# Never commit .env — only this template.

# ── Django core ──────────────────────────────────────────────────────────
# DJANGO_SETTINGS_MODULE=          # bizal.settings.local | dev | production
# SECRET_KEY=                      # required in production
# DEBUG=                           # True only for local dev; production refuses to boot with it on
# ALLOWED_HOSTS=                   # comma-separated, leading dot for subdomains: bizal.al,.bizal.al
# CSRF_TRUSTED_ORIGINS=            # comma-separated: https://bizal.al,https://*.bizal.al
# MAIN_DOMAIN=
# FRONTEND_BASE_URL=               # required in production
# DEMO_BASE_URL=
# ALLOW_TENANT_QUERY_PARAM=        # true only on a bare *.up.railway.app host (no wildcard DNS)
# SERVE_MEDIA_WITHOUT_NGINX=       # true on Railway (no nginx); attach a volume for uploads
# SECURE_SSL_REDIRECT=             # true only after HTTPS is working
# LOG_LEVEL=
# APP_VERSION=

# ── Database (PostgreSQL) ────────────────────────────────────────────────
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_CONN_MAX_AGE=

# ── Redis / Celery ───────────────────────────────────────────────────────
# REDIS_PASSWORD=                  # used by docker-compose
# REDIS_URL=                       # Celery broker
# REDIS_CACHE_URL=                 # Django cache
# REDIS_RESULT_URL=                # Celery result backend
# CELERY_WORKER_RUNNING=           # true on celery-worker and celery-beat ONLY

# ── Stripe (leave unset to disable billing) ──────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ENTERPRISE=

# ── Email / SMTP (leave unset to disable outbound email) ─────────────────
# EMAIL_HOST=
# EMAIL_PORT=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=
# EMAIL_USE_SSL=
# DEFAULT_FROM_EMAIL=
# ADMIN_EMAIL=

# ── Chatbot LLM providers ────────────────────────────────────────────────
# GROQ_API_KEY_1=
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=
# OPENROUTER_API_KEY_1=
# OPENROUTER_API_KEY_2=
# OPENROUTER_API_KEY_3=
# STAFF_REPLY_TTL=                 # seconds

# ── Misc integrations ────────────────────────────────────────────────────
# FX_RATE_API_URL=
# SENTRY_DSN=

# ── Seed passwords (local/dev seeding only; if unset, seed.py generates
#    random ones and writes them to .env.seed) ────────────────────────────
# SEED_ADMIN_PASSWORD=
# SEED_CUSTOMER_PASSWORD=
# SEED_OWNER_PASSWORD=
# SEED_OWNER_PASSWORD_RESTO=
# SEED_OWNER_PASSWORD_HOTEL=
# SEED_OWNER_PASSWORD_CLINIC=
# SEED_OWNER_PASSWORD_BARBER=
# SEED_OWNER_PASSWORD_CARS=
# SEED_OWNER_PASSWORD_TRAVEL=
# SEED_OWNER_PASSWORD_REALEST=
# SEED_OWNER_PASSWORD_MARKET=
# SEED_OWNER_PASSWORD_LANGSC=
# SEED_OWNER_PASSWORD_CONSTR=

# ── Backups / Docker tuning (docker-compose.yml only) ────────────────────
# BACKUP_S3_BUCKET=
# BACKUP_S3_PREFIX=
# BACKUP_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# GUNICORN_WORKERS=
# GUNICORN_SPA_WORKERS=
# GUNICORN_SPA_THREADS=
# PGBOUNCER_POOL_SIZE=
